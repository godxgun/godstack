COOL void Api(char *name, char *func, char *desc) {
    <div class="api-card">
        <h3 class="api-name">{ name }</h3>
        <code class="language-c">{ func } </code>
        <div class="api-description">
            { desc }
        </div>
    </div>
}

COOL void LibLink(char *name) {
    <a class="lib" href="/{ name }">{ name }</a>
}
